# Copy to .env (or export) and adjust. Every variable is optional except
# where noted.

# Server
VIGIL_ADDR=:4210
VIGIL_CONFIG=vigil.yaml
VIGIL_DB=vigil.db
# Dashboard sign-in. If unset, the server generates one per run and logs it.
VIGIL_ADMIN_TOKEN=
# Shared secret for remote probes. Unset disables the remote probe API.
VIGIL_PROBE_TOKEN=
# Region of the probe embedded in the server, or "off".
VIGIL_LOCAL_REGION=local
# Public URL, used for links in alerts and the Atom feed. https:// also
# marks the session cookie Secure.
VIGIL_BASE_URL=
VIGIL_WATCH_CONFIG=true
VIGIL_LOG_LEVEL=info
VIGIL_LOG_FORMAT=text

# Probe (vigil probe)
VIGIL_SERVER=http://127.0.0.1:4210
VIGIL_REGION=
VIGIL_PROBE_ID=

# Referenced from vigil.yaml as ${NAME}; examples/vigil.yaml uses these.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
